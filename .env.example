# Solo desarrollo local. No usar credenciales reales en el prototipo.
PORT=8787
DATA_DIR=./.local/postgres
# Si se define, reemplaza la contraseña temporal generada en .local/credenciales.txt.
DEMO_PASSWORD=

# WhatsApp Cloud API (Meta). Sin estas variables los avisos a clientes quedan pendientes, sin gastar reintentos.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Token que se escribe en Meta al registrar el webhook /api/whatsapp/webhook
WHATSAPP_VERIFY_TOKEN=
# Secreto de la app de Meta: valida la firma de cada mensaje entrante
WHATSAPP_APP_SECRET=

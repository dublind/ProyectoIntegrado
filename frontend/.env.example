# Copia este archivo como .env.local (ignorado por git) y completa los valores.
#   cp .env.example .env.local
# Las variables VITE_* quedan incluidas en el JavaScript del navegador: nunca pongas aquí secretos de servidor.

# Key de Maps JavaScript API. Sin key, el mapa de seguimiento usa OpenStreetMap.
# Restríngela en Google Cloud Console:
#   - Sitios web (HTTP referrers): http://localhost:5173/* y el dominio de producción.
#   - APIs: solo Maps JavaScript API.
VITE_GOOGLE_MAPS_API_KEY=

# Opcional: Map ID para estilos de mapa en la nube. Si se omite se usa DEMO_MAP_ID.
VITE_GOOGLE_MAPS_MAP_ID=

# Llegada a la parada (app del chofer): la entrega se confirma solo dentro de este radio (metros).
VITE_RADIO_LLEGADA_M=150
# Precisión GPS máxima (metros) para aceptar la llegada; con peor señal hay que esperar o pedir validación a la oficina.
VITE_GPS_PRECISION_MAX_M=100
# Simulación de ubicación (demo en escritorio). Siempre activa en `npm run dev`; en un build de
# producción queda deshabilitada salvo que se ponga true aquí. No activar en producción real.
VITE_GPS_SIMULADO=
